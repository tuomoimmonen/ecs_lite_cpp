## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# --- KÄYTTÖJÄRJESTELMÄT & PERUSJUTUT ---
.DS_Store
.DS_Store?
._*
.Trashes
ehthumbs.db
Thumbs.db

# --- VISUAL STUDIO (Windows) ---
.vs/
*.user
*.suo
*.opensdf
*.sdf
*.aps
*.ncb
*.idb
ipch/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
*.tlog

# --- VISUAL STUDIO CODE (Mac & Windows) ---
# Estetään kaikki VS Code -asetukset, jotta Mac-asetukset eivät sotke Windows-konetta
.vscode/
*.code-workspace
.history/

# --- KÄÄNNÖKSET (Binäärit & Kirjastot) ---
# Windows
*.exe
*.dll
*.obj
*.pdb
*.ilk
*.msi
*.lib
*.exp

# Mac / Linux
*.out
*.app
*.dSYM/
*.dylib
*.a

# --- MUUT ---
# Estetään varmuuskopiot ja turhat tiedostot
*.bak
*.tmp
*.log

# CMake väliaikaistiedostot (VS Code oletus)
out/
build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt